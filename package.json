{
  "name": "@guojing6/dsh-deepseek-chat",
  "version": "1.0.0",
  "description": "DeepSeek Harness title dropdown: open DeepSeek Chat in the current page or close the menu by selecting DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "chat",
    "web-chat"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guojing6/dsh-deepseek-chat.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "jsdom": "^26.1.0"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check lib/client.js && node --check lib/index.js"
  }
}
